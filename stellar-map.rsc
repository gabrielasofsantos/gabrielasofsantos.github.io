3:[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"Stellar Map — Gabriela Santos"}],["$","meta","1",{"name":"description","content":"O projeto partiu do desafio de criar um website inspirado no vídeo Factos sobre o Universo, de Brian Cox. A ideia foi explorar o universo das estrelas e constelações, transformando o site num céu interativo onde é possível descobrir e explorar diferentes constelações. As estrelas são representadas através de três cores, de acordo com o seu nível de brilho, e cada constelação pode ser selecionada para conhecer melhor as estrelas que a constituem, combinando exploração visual e aprendizagem."}],["$","meta","2",{"property":"og:title","content":"Gabriela Santos — Design Portfolio"}],["$","meta","3",{"property":"og:description","content":"Selected graphic design, editorial, identity and digital projects by Gabriela Santos."}],["$","meta","4",{"property":"og:url","content":"https://gabrielasofsantos.github.io"}],["$","meta","5",{"property":"og:site_name","content":"Gabriela Santos"}],["$","meta","6",{"property":"og:type","content":"website"}],["$","meta","7",{"property":"og:image","content":"https://gabrielasofsantos.github.io/og.png"}],["$","meta","8",{"property":"og:image:width","content":"1200"}],["$","meta","9",{"property":"og:image:height","content":"630"}],["$","meta","10",{"property":"og:image:alt","content":"Gabriela Santos — Design Portfolio"}],["$","meta","11",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","12",{"name":"twitter:title","content":"Gabriela Santos — Design Portfolio"}],["$","meta","13",{"name":"twitter:description","content":"Selected graphic design, editorial, identity and digital projects by Gabriela Santos."}],["$","meta","14",{"name":"twitter:image","content":"https://gabrielasofsantos.github.io/og.png"}],["$","link","15",{"rel":"canonical","href":"https://gabrielasofsantos.github.io/stellar-map"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initi