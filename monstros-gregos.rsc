3:[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"Monstros Gregos — Gabriela Santos"}],["$","meta","1",{"name":"description","content":"O projeto surgiu do desafio de transformar criaturas da mitologia grega em objetos físicos, mantendo as suas características mais reconhecíveis. A ideia foi criar um conjunto de peças de madeira que pudessem ser combinadas de diferentes formas, permitindo construir tanto as criaturas originais como novas figuras imaginárias. As peças foram desenhadas digitalmente através de ilustração vetorial e produzidas em madeira com recurso a corte a laser, dando origem a um sistema de montagem simples e interativo."}],["$","meta","2",{"property":"og:title","content":"Gabriela Santos — Design Portfolio"}],["$","meta","3",{"property":"og:description","content":"Selected graphic design, editorial, identity and digital projects by Gabriela Santos."}],["$","meta","4",{"property":"og:url","content":"https://gabrielasofsantos.github.io"}],["$","meta","5",{"property":"og:site_name","content":"Gabriela Santos"}],["$","meta","6",{"property":"og:type","content":"website"}],["$","meta","7",{"property":"og:image","content":"https://gabrielasofsantos.github.io/og.png"}],["$","meta","8",{"property":"og:image:width","content":"1200"}],["$","meta","9",{"property":"og:image:height","content":"630"}],["$","meta","10",{"property":"og:image:alt","content":"Gabriela Santos — Design Portfolio"}],["$","meta","11",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","12",{"name":"twitter:title","content":"Gabriela Santos — Design Portfolio"}],["$","meta","13",{"name":"twitter:description","content":"Selected graphic design, editorial, identity and digital projects by Gabriela Santos."}],["$","meta","14",{"name":"twitter:image","content":"https://gabrielasofsantos.github.io/og.png"}],["$","link","15",{"rel":"canonical","href":"https://gabrielasofsantos.github.io/monstros-gregos"}]],[["$","meta","0",{"name":"viewport","content":"wi