3:[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"They Control You — Gabriela Santos"}],["$","meta","1",{"name":"description","content":"Projeto final de curso da ESAD, desenvolvido em 2026, a partir do tema “Extremos”, explorando o extremo da vigilância. O projeto deu origem a um livro que procura alertar para a constante vigilância a que estamos sujeitos, muitas vezes sem nos apercebermos. O uso de papéis prateados refletores expõe o rosto do leitor, reforçando a sensação de falta de privacidade. Ao rasgar as páginas para descobrir o seu interior, o próprio leitor participa na invasão de privacidade que o projeto pretende questionar."}],["$","meta","2",{"property":"og:title","content":"Gabriela Santos — Design Portfolio"}],["$","meta","3",{"property":"og:description","content":"Selected graphic design, editorial, identity and digital projects by Gabriela Santos."}],["$","meta","4",{"property":"og:url","content":"https://gabrielasofsantos.github.io"}],["$","meta","5",{"property":"og:site_name","content":"Gabriela Santos"}],["$","meta","6",{"property":"og:type","content":"website"}],["$","meta","7",{"property":"og:image","content":"https://gabrielasofsantos.github.io/og.png"}],["$","meta","8",{"property":"og:image:width","content":"1200"}],["$","meta","9",{"property":"og:image:height","content":"630"}],["$","meta","10",{"property":"og:image:alt","content":"Gabriela Santos — Design Portfolio"}],["$","meta","11",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","12",{"name":"twitter:title","content":"Gabriela Santos — Design Portfolio"}],["$","meta","13",{"name":"twitter:description","content":"Selected graphic design, editorial, identity and digital projects by Gabriela Santos."}],["$","meta","14",{"name":"twitter:image","content":"https://gabrielasofsantos.github.io/og.png"}],["$","link","15",{"rel":"canonical","href":"https://gabrielasofsantos.github.io/they-control-you"}]],[["$","meta","0",{"name":"viewport","content":"wid