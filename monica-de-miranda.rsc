3:[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"Mónica de Miranda — Gabriela Santos"}],["$","meta","1",{"name":"description","content":"O projeto consistiu na criação de um jornal A3 para uma exposição de Mónica de Miranda, na Galeria do Palácio de Cristal. Com entrevistas, biografia e informação sobre a artista, o jornal foi inspirado na relação entre a natureza, a identidade e a ideia de casa, presentes na exposição. A linguagem visual explora o verde e uma tipografia que remete para raízes, criando uma ligação entre o conteúdo e o universo artístico da exposição."}],["$","meta","2",{"property":"og:title","content":"Gabriela Santos — Design Portfolio"}],["$","meta","3",{"property":"og:description","content":"Selected graphic design, editorial, identity and digital projects by Gabriela Santos."}],["$","meta","4",{"property":"og:url","content":"https://gabrielasofsantos.github.io"}],["$","meta","5",{"property":"og:site_name","content":"Gabriela Santos"}],["$","meta","6",{"property":"og:type","content":"website"}],["$","meta","7",{"property":"og:image","content":"https://gabrielasofsantos.github.io/og.png"}],["$","meta","8",{"property":"og:image:width","content":"1200"}],["$","meta","9",{"property":"og:image:height","content":"630"}],["$","meta","10",{"property":"og:image:alt","content":"Gabriela Santos — Design Portfolio"}],["$","meta","11",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","12",{"name":"twitter:title","content":"Gabriela Santos — Design Portfolio"}],["$","meta","13",{"name":"twitter:description","content":"Selected graphic design, editorial, identity and digital projects by Gabriela Santos."}],["$","meta","14",{"name":"twitter:image","content":"https://gabrielasofsantos.github.io/og.png"}],["$","link","15",{"rel":"canonical","href":"https://gabrielasofsantos.github.io/monica-de-miranda"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L9",null,{"fallback":"$